digraph MPD {
  graph [
    label="TAFITA MANAGER — MODÈLE PHYSIQUE DES DONNÉES\nVue synthétique des principales tables métier",
    labelloc=t, labeljust=c, fontsize=24, fontname="Arial", fontcolor="#142238",
    rankdir=LR, splines=polyline, nodesep=0.40, ranksep=0.72,
    pad=0.35, bgcolor="#ffffff", outputorder=edgesfirst
  ];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#54708e", fontcolor="#324a62", penwidth=1.35, arrowsize=0.75];

  user [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#193b63">
    <TR><TD COLSPAN="3" BGCOLOR="#18314f"><FONT COLOR="white"><B>Utilisateur</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">auth_user · Django</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#dbeafe">PK</TD></TR>
    <TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar, unique</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">first_name / last_name</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">is_staff / is_active</TD><TD ALIGN="LEFT">boolean</TD><TD> </TD></TR>
  </TABLE>>];

  member [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2459bf">
    <TR><TD COLSPAN="3" BGCOLOR="#2459bf"><FONT COLOR="white"><B>Membre</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">members_member</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#dbeafe">PK</TD></TR>
    <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK nullable</TD><TD BGCOLOR="#dbeafe">FK</TD></TR>
    <TR><TD ALIGN="LEFT">first_name / last_name</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">email</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">joined_on / status</TD><TD ALIGN="LEFT">date / varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">photo / activation_code</TD><TD ALIGN="LEFT">fichier / varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">notes / created_at / updated_at</TD><TD ALIGN="LEFT">text / timestamp</TD><TD> </TD></TR>
  </TABLE>>];

  contribution [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#0e91ad">
    <TR><TD COLSPAN="3" BGCOLOR="#0e91ad"><FONT COLOR="white"><B>Cotisation</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">contributions_contribution</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#cffafe">PK</TD></TR>
    <TR><TD ALIGN="LEFT">member_id</TD><TD ALIGN="LEFT">FK, PROTECT</TD><TD BGCOLOR="#cffafe">FK</TD></TR>
    <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(150)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">bigint positif (Ar)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT">date nullable</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD><TD> </TD></TR>
    <TR><TD COLSPAN="3" BGCOLOR="#ecfeff"><FONT POINT-SIZE="9">total_paid, remaining_amount et current_status sont calculés</FONT></TD></TR>
  </TABLE>>];

  payment [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#18845d">
    <TR><TD COLSPAN="3" BGCOLOR="#18845d"><FONT COLOR="white"><B>Paiement</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">contributions_payment</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#dcfce7">PK</TD></TR>
    <TR><TD ALIGN="LEFT">contribution_id</TD><TD ALIGN="LEFT">FK, PROTECT</TD><TD BGCOLOR="#dcfce7">FK</TD></TR>
    <TR><TD ALIGN="LEFT">amount / payment_date</TD><TD ALIGN="LEFT">bigint / date</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">method / reference</TD><TD ALIGN="LEFT">varchar</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">notes / created_at</TD><TD ALIGN="LEFT">text / timestamp</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">is_voided / voided_at</TD><TD ALIGN="LEFT">boolean / timestamp nullable</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">voided_by_id</TD><TD ALIGN="LEFT">FK nullable → auth_user</TD><TD BGCOLOR="#dcfce7">FK</TD></TR>
    <TR><TD ALIGN="LEFT">void_reason</TD><TD ALIGN="LEFT">varchar(300)</TD><TD> </TD></TR>
  </TABLE>>];

  submission [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8861b5">
    <TR><TD COLSPAN="3" BGCOLOR="#6d4aa1"><FONT COLOR="white"><B>Déclaration de paiement</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">community_memberpaymentsubmission</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#ede9fe">PK</TD></TR>
    <TR><TD ALIGN="LEFT">member_id</TD><TD ALIGN="LEFT">FK → members_member</TD><TD BGCOLOR="#ede9fe">FK</TD></TR>
    <TR><TD ALIGN="LEFT">contribution_id</TD><TD ALIGN="LEFT">FK → contributions_contribution</TD><TD BGCOLOR="#ede9fe">FK</TD></TR>
    <TR><TD ALIGN="LEFT">submitted_by_id</TD><TD ALIGN="LEFT">FK → auth_user</TD><TD BGCOLOR="#ede9fe">FK</TD></TR>
    <TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">montant positif</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">proof</TD><TD ALIGN="LEFT">fichier justificatif</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">pending / approved / rejected</TD><TD> </TD></TR>
  </TABLE>>];

  event [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2459bf">
    <TR><TD COLSPAN="3" BGCOLOR="#2459bf"><FONT COLOR="white"><B>Événement</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">events_event</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#dbeafe">PK</TD></TR>
    <TR><TD ALIGN="LEFT">title / description</TD><TD ALIGN="LEFT">varchar / text</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">date / end_date</TD><TD ALIGN="LEFT">timestamp / nullable</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">varchar(200)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">responsible</TD><TD ALIGN="LEFT">varchar(150)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp</TD><TD> </TD></TR>
  </TABLE>>];

  notification [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#18845d">
    <TR><TD COLSPAN="3" BGCOLOR="#18845d"><FONT COLOR="white"><B>Notification</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="9">community_notification</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD BGCOLOR="#dcfce7">PK</TD></TR>
    <TR><TD ALIGN="LEFT">recipient_id</TD><TD ALIGN="LEFT">FK → auth_user</TD><TD BGCOLOR="#dcfce7">FK</TD></TR>
    <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(160)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">text</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">event / payment / community / system</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">url</TD><TD ALIGN="LEFT">varchar(300)</TD><TD> </TD></TR>
    <TR><TD ALIGN="LEFT">created_at / read_at</TD><TD ALIGN="LEFT">timestamp / nullable</TD><TD> </TD></TR>
  </TABLE>>];

  user -> member [label="user_id nullable", dir=both, arrowtail=none, arrowhead=crow];
  member -> contribution [label="1 membre possède 0..N cotisations", arrowhead=crow];
  contribution -> payment [label="1 cotisation reçoit 0..N paiements", arrowhead=crow];
  member -> submission [label="1 membre effectue 0..N déclarations", arrowhead=crow];
  contribution -> submission [label="1 cotisation peut avoir 0..N déclarations", arrowhead=crow];
  user -> submission [label="1 utilisateur soumet 0..N déclarations", arrowhead=crow];
  user -> payment [label="annulations par un utilisateur\nvoided_by_id nullable", style=dashed, color="#8a9bb0", arrowhead=crow];
  user -> notification [label="1 utilisateur reçoit 0..N notifications", arrowhead=crow];

}
